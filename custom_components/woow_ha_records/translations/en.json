  "exceptions": {
    "member_not_found": {
      "message": "Member '{member_id}' not found."
    },
    "record_type_not_found": {
      "message": "Record type '{record_type}' not found for member '{member_id}'."
    },
    "record_not_found": {
      "message": "Record not found."
    },
    "invalid_datetime": {
      "message": "Invalid datetime for '{field}': {value}"
    },
    "log_failed": {
      "message": "Failed to log record."
    },
    "invalid_type_id": {
      "message": "Name must contain at least one alphanumeric character."
    },
    "type_exists": {
      "message": "Record type '{type_id}' already exists."
    },
    "type_not_found": {
      "message": "Record type '{type_id}' not found."
    },
    "invalid_member_id": {
      "message": "Member ID is empty after sanitization."
    },
    "member_exists": {
      "message": "Member '{member_id}' already exists."
    },
    "create_failed": {
      "message": "Failed to create member."
    }
