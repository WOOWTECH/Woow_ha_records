      "fields": {
        "member_id": {
          "name": "Member ID",
          "description": "The member's unique identifier."
        },
        "name": {
          "name": "Name",
          "description": "Human-readable name for the record type."
        },
        "unit": {
          "name": "Unit",
          "description": "Unit of measurement (e.g. kg, bpm)."
        },
        "default_value": {
          "name": "Default Value",
          "description": "Initial default value."
        },
        "default_value_mode": {
          "name": "Default Value Mode",
          "description": "\"fixed\" or \"last_value\"."
        }
      }
