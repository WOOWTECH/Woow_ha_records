        "member_id": {
          "name": "Member ID",
          "description": "The member's unique identifier."
        },
        "type_id": {
          "name": "Type ID",
          "description": "The record type ID to update."
        },
        "name": {
          "name": "Name",
          "description": "New human-readable name."
        },
        "unit": {
          "name": "Unit",
          "description": "New unit of measurement."
        },
        "default_value": {
          "name": "Default Value",
          "description": "New default value."
        },
        "default_value_mode": {
          "name": "Default Value Mode",
          "description": "\"fixed\" or \"last_value\"."
        }
      }
