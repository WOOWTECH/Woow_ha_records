          "name": "Member ID",
          "description": "Optional unique identifier. Auto-generated from name if omitted."
        },
        "note": {
          "name": "Note",
          "description": "Optional free-text note."
        }
      }
    },
    "health_update_member": {
      "name": "Update Member",
      "description": "Update a member's display name and note.",
      "fields": {
        "member_id": {
          "name": "Member ID",
          "description": "The member's unique identifier."
        },
        "name": {
          "name": "Name",
          "description": "New display name."
        },
        "note": {
          "name": "Note",
          "description": "New note."
