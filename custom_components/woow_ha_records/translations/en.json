  "services": {
    "health_get_members": {
      "name": "Get Members",
      "description": "List all family members and their record types."
    },
    "health_get_records": {
      "name": "Get Records",
      "description": "Query health records within a time range.",
      "fields": {
        "start_time": {
          "name": "Start Time",
          "description": "Start of the time range (ISO 8601)."
        },
        "end_time": {
          "name": "End Time",
          "description": "End of the time range (ISO 8601)."
        }
      }
    },
    "health_export_csv": {
      "name": "Export CSV",
      "description": "Export all records for a member as CSV text.",
      "fields": {
        "member_id": {
          "name": "Member ID",
          "description": "The member's unique identifier."
        }
      }
    },
    "health_log_record": {
      "name": "Log Record",
      "description": "Log a new health record for a member.",
      "fields": {
        "member_id": {
          "name": "Member ID",
          "description": "The member's unique identifier."
        },
        "record_type": {
          "name": "Record Type",
          "description": "The record type ID (e.g. weight, feeding)."
        },
        "value": {
          "name": "Value",
          "description": "The measured value."
        },
        "note": {
          "name": "Note",
          "description": "Optional free-text note."
        },
        "timestamp": {
          "name": "Timestamp",
          "description": "Optional ISO 8601 timestamp. Defaults to now."
        }
      }
    },
    "health_update_record": {
      "name": "Update Record",
      "description": "Update an existing health record.",
      "fields": {
        "member_id": {
          "name": "Member ID",
          "description": "The member's unique identifier."
        },
        "type_id": {
          "name": "Type ID",
          "description": "The record type ID."
        },
        "timestamp": {
          "name": "Timestamp",
          "description": "ISO 8601 timestamp to locate the record."
        },
        "record_id": {
          "name": "Record ID",
          "description": "Optional UUID of the record (preferred over timestamp)."
        },
        "value": {
          "name": "Value",
          "description": "New value for the record."
        },
        "note": {
          "name": "Note",
          "description": "New note for the record."
        },
        "new_timestamp": {
          "name": "New Timestamp",
          "description": "Replacement timestamp (ISO 8601)."
        }
      }
    },
    "health_delete_record": {
      "name": "Delete Record",
      "description": "Delete a single health record.",
      "fields": {
        "member_id": {
          "name": "Member ID",
          "description": "The member's unique identifier."
        },
        "type_id": {
          "name": "Type ID",
          "description": "The record type ID."
        },
        "timestamp": {
          "name": "Timestamp",
          "description": "ISO 8601 timestamp to locate the record."
        },
        "record_id": {
          "name": "Record ID",
          "description": "Optional UUID of the record (preferred over timestamp)."
        }
      }
    },
    "health_add_record_type": {
      "name": "Add Record Type",
