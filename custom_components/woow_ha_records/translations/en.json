      },
      "last_note": {
        "name": "Last Note"
      },
      "last_time": {
        "name": "Last Time"
      },
      "plan_next_date": {
        "name": "{title} Next Date"
      },
      "plan_last_executed": {
        "name": "{title} Last Executed"
      },
